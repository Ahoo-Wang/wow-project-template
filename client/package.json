{
  "name": "@ahoo-wang/wow-template-client",
  "version": "0.0.1",
  "description": "Typed TypeScript clients of the blog service, generated from its Wow Manifest",
  "keywords": [
    "wow",
    "client",
    "typescript"
  ],
  "author": "Ahoo-Wang",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Ahoo-Wang/wow-project-template",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ahoo-Wang/wow-project-template.git",
    "directory": "client"
  },
  "bugs": {
    "url": "https://github.com/Ahoo-Wang/wow-project-template/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "clean": "pnpm clean:dist && pnpm clean:generated",
    "clean:dist": "rimraf dist",
    "clean:generated": "rimraf src/generated",
    "generate": "node scripts/generate.mjs",
    "prepublishOnly": "pnpm clean:dist && pnpm generate && pnpm lint && pnpm build",
    "release": "pnpm publish --access public --no-git-checks",
    "release:patch": "pnpm version patch && pnpm publish --access public --no-git-checks",
    "release:minor": "pnpm version minor && pnpm publish --access public --no-git-checks",
    "release:major": "pnpm version major && pnpm publish --access public --no-git-checks"
  },
  "peerDependencies": {
    "@ahoo-wang/fetcher": "^8.0.0",
    "@ahoo-wang/fetcher-eventstream": "^8.0.0",
    "@ahoo-wang/wow-client": "~10.0.0-beta.22"
  },
  "devDependencies": {
    "@ahoo-wang/fetcher-decorator": "^8.0.0",
    "@ahoo-wang/wow-generator": "10.0.0-beta.22",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "@vitest/ui": "^5.1.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.8",
    "vite-bundle-analyzer": "^1.3.9",
    "vitest": "^5.1.2"
  }
}
